# =============================================================================
# CFCBot central runtime configuration
# Copy to .env, fill secrets, then keep .env outside Git.
# =============================================================================

# Safety locks. Production start refuses while this is false.
CFCBOT_PRODUCTION_ENABLED=false
CFCBOT_ADOPT_LEGACY_RUNTIME=false
CFCBOT_STOP_OLLAMA_ON_STOP=false
CFCBOT_TIMEZONE=Asia/Ho_Chi_Minh
CFCBOT_API_HOST=127.0.0.1
CFCBOT_API_PORT=7777
CFCBOT_API_BASE_URL=http://127.0.0.1:7777
CFCBOT_IMAGE=cfcbot-api:local

# Redis. Defaults point to the existing persistent volume only after cutover.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_VOLUME_NAME=redis_redis-data

# Ollama stays on the Linux host.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_DIM=1024
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_FALLBACK_EMBED_MODEL=qwen2.5:7b-instruct

# n8n. Existing data can be adopted after legacy containers are stopped.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.39.6
N8N_PORT=5678
N8N_HOST=n8n.dinhduongcantho.io.vn
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://n8n.dinhduongcantho.io.vn
WEBHOOK_URL=https://n8n.dinhduongcantho.io.vn/
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=false
N8N_DATA_DIR=/home/kali/javis-runtime/n8n-home/.n8n
# Existing encryption key remains in N8N_DATA_DIR/config. Do not replace it
# during migration or old credentials become unreadable.
N8N_API_KEY=

# Reuse the installed host service during migration. Set mode=docker and
# CLOUDFLARE_ENABLED=true only when moving the connector into Compose.
CLOUDFLARE_MODE=systemd
CLOUDFLARE_ENABLED=false
CLOUDFLARE_IMAGE=cloudflare/cloudflared:latest
CLOUDFLARE_TUNNEL_TOKEN=

# AI provider selection. Keep local during migration unless explicitly changed.
AI_EXECUTION_MODE=local
AI_PREFERRED_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Conversation/runtime safety.
LLM_NLU_MODE=off
LLM_NLU_TIMEOUT=1.6
LLM_NLU_CONFIDENCE=0.72
CHAT_CONVERSATION_MODE=assist
CHAT_CONVERSATION_MIN_CONFIDENCE=0.85
CHAT_CONVERSATION_HISTORY_LIMIT=6
CHAT_CONVERSATION_TIMEOUT_SECONDS=6
CHAT_CONVERSATION_CONTROL_KEY=CHANGE_ME_INTERNAL_CONTROL_KEY
CHAT_CANARY_MODE=off
CHAT_CANARY_PERCENT=0
CHAT_CANARY_SALT=CHANGE_ME_CANARY_SALT
CHAT_CANARY_ALLOW_HIGH_RISK=false

# Telegram. Add regional destinations later; this is the current default group.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AMIS CRM secrets are environment-only.
AMIS_BASE_URL=https://crmconnect.misa.vn/api/v2
AMIS_CLIENT_ID=JavisCFCChatbot
AMIS_CLIENT_SECRET=
AMIS_SYNC_INTERNAL_TOKEN=
AMIS_ORDER_LOOKUP_HMAC_SECRET=
AMIS_LOYALTY_LOOKUP_HMAC_SECRET=

# Meta credentials remain in n8n credentials today. These placeholders document
# the complete secret inventory for a future direct Meta gateway.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_CFC_PAGE_ACCESS_TOKEN=
META_ZEO_PAGE_ACCESS_TOKEN=

# Other integrations.
SHOPEE_SHEET_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=
